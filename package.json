{
  "name": "satoshi-browser",
  "version": "0.1.0",
  "description": "A sovereign Bitcoin and Ordinals desktop browser",
  "homepage": "https://github.com/HGraph-Punks/bitcoin-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/HGraph-Punks/bitcoin-browser.git"
  },
  "type": "module",
  "main": "src/main/index.js",
  "author": {
    "name": "Turtle Moon Command Center",
    "email": "patches@turtlemoon.io"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "SATOSHI_BROWSER_DEV=1 electron .",
    "build:icons": "node scripts/build-icons.mjs",
    "check:icons": "node scripts/build-icons.mjs --check",
    "build:viewers": "node scripts/build-viewers.mjs",
    "check:viewers": "node scripts/build-viewers.mjs --check",
    "check": "npm run check:viewers && node scripts/check.mjs",
    "test": "node --test --test-concurrency=2 --test-timeout=120000 --test-reporter=spec tests/*.test.js",
    "verify": "npm run check && npm test",
    "security:beta": "node scripts/beta-security.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "pack": "node scripts/package.mjs --unsigned --dir",
    "dist": "node scripts/package.mjs",
    "dist:mac": "node scripts/package.mjs --mac",
    "dist:win": "node scripts/package.mjs --win",
    "dist:linux": "node scripts/package.mjs --linux",
    "source:archive": "node scripts/source-archive.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.2.0",
    "electron-builder": "26.16.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "org.satoshibrowser.desktop",
    "productName": "Bitcoin Browser",
    "asar": true,
    "asarUnpack": [],
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-sign.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "SECURITY.md"
    ],
    "protocols": [
      {
        "name": "Bitcoin Browser links",
        "schemes": [
          "satnav"
        ]
      }
    ],
    "mac": {
      "artifactName": "bitcoin-browser-${version}-macos-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "artifactName": "bitcoin-browser-${version}-windows-${arch}.${ext}",
      "verifyUpdateCodeSignature": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "bitcoin-browser-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "bitcoin-browser-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "artifactName": "bitcoin-browser-${version}-linux-${arch}.${ext}",
      "maintainer": "Turtle Moon Command Center <patches@turtlemoon.io>",
      "executableName": "bitcoin-browser",
      "category": "Network;Utility",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@jsquash/jxl": "1.3.0",
    "marked": "18.0.12",
    "pdfjs-dist": "6.3.289",
    "three": "0.186.0"
  }
}
